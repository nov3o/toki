[package]
name = "toki-train"
version = "0.1.0"
edition = "2024"

[dependencies]
tk-train = { path = "@PR@/tokenizers/tk-train" }
tk-encode = { path = "@PR@/tokenizers/tk-encode", features = ["parallelism"] }
rust_bpe = { path = "@RB@" }
ahash = "0.8"
compact_str = "0.9"
mimalloc = { version = "0.1", default-features = false }
libmimalloc-sys = { version = "0.1", features = ["extended"] }
bitcannon = { path = "@PR@/tokenizers/bitcannon" }

[profile.release]
lto = "thin"
codegen-units = 1
